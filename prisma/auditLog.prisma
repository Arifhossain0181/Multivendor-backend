model AuditLog {
  id          String    @id @default(uuid())
  adminId     String
  action      String
  entityType  String?
  entityId    String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@map("audit_logs")
  @@index([adminId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}
